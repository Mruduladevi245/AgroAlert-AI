# GEMINI_API_KEY: Required for Gemini AI API calls (assistant, crop scanner, TTS, transcription, translation).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=YOUR_API_KEY_HERE

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret key for signing session tokens (defaults to ephemeral dev secret if unset).
SESSION_SECRET="CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING"

# SQLITE_DB_PATH: Path to SQLite database file (defaults to ./data/agroalert.db).
SQLITE_DB_PATH="./data/agroalert.db"

# GOOGLE_CLOUD_TTS_API_KEY: Optional API key for Google Cloud Text-to-Speech API.
# When unset, AgroAlert AI uses Gemini 3.8 TTS (via GEMINI_API_KEY) or compatible browser speech synthesis.
GOOGLE_CLOUD_TTS_API_KEY=""

# TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN / TWILIO_FROM_NUMBER: Optional credentials for real SMS dispatch.
# When unset, SMS alerts operate in clearly labelled Demo Mode.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# WEBAUTHN_RP_ID / WEBAUTHN_ORIGIN: Optional overrides for WebAuthn relying party domain.
WEBAUTHN_RP_ID=""
WEBAUTHN_ORIGIN=""
